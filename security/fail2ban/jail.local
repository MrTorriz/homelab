[DEFAULT]
bantime  = 1h
findtime = 30m
maxretry = 3

# Use whatever backend the distro's sshd ships with (systemd on
# modern Ubuntu, file-based on older hosts). Portable across forks.
backend  = %(sshd_backend)s

# Don't lock yourself out. Add the real administration subnet in a local override.
ignoreip = 127.0.0.1/8

[sshd]
enabled = true
mode    = aggressive
port    = 2222
logpath = %(sshd_log)s
action  = %(action_)s
          ntfy

# fail2ban handles brute-force against SSH and the reverse proxy; event pushes
# (SSH login, sudo, file changes) cover what a ban cannot.
