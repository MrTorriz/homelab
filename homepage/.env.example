# Homepage secrets — copy to ${APPDATA_DIR}/homepage/.env and fill in.
# Loaded by the homepage container (env_file) and substituted into
# services.yaml as {{HOMEPAGE_VAR_*}}. The real .env is never committed.
# Prefer read-only API keys/tokens wherever the service offers them.

# Network
HOMEPAGE_VAR_ADGUARD_USERNAME=changeme
HOMEPAGE_VAR_ADGUARD_PASSWORD=changeme
HOMEPAGE_VAR_NPM_USERNAME=changeme
HOMEPAGE_VAR_NPM_PASSWORD=changeme
HOMEPAGE_VAR_CLOUDFLARED_ACCOUNT=changeme
HOMEPAGE_VAR_CLOUDFLARED_TUNNEL=changeme
HOMEPAGE_VAR_CLOUDFLARED_KEY=changeme

# System
HOMEPAGE_VAR_PORTAINER_KEY=changeme
# Separate read-only serverinfo token, never the admin password
HOMEPAGE_VAR_NEXTCLOUD_TOKEN=changeme

# Media
HOMEPAGE_VAR_JELLYFIN_KEY=changeme
HOMEPAGE_VAR_QBIT_USER=changeme
HOMEPAGE_VAR_QBIT_PASS=changeme
HOMEPAGE_VAR_AUDIOBOOKSHELF_KEY=changeme
HOMEPAGE_VAR_IMMICH_KEY=changeme

# Media management
HOMEPAGE_VAR_OVERSEERR_KEY=changeme
HOMEPAGE_VAR_RADARR_KEY=changeme
HOMEPAGE_VAR_SONARR_KEY=changeme
HOMEPAGE_VAR_BAZARR_KEY=changeme
HOMEPAGE_VAR_PROWLARR_KEY=changeme
