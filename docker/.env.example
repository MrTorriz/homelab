# ────────────────────────────────────────────────────────────
# Homelab — example environment file
# Copy to `.env` and fill in real values. Never commit `.env`.
# ────────────────────────────────────────────────────────────

# ── Host & network ──
# Documentation-only address. Replace it with the deployment host's LAN address.
LAN_IP=192.0.2.10
# Replace with the actual reverse-proxy subnet used by the deployment.
TRUSTED_PROXIES=198.51.100.0/24
DOMAIN=example.com
# Gateway of the `homelab` bridge network; Homepage resolves proxied
# hostnames to it (see extra_hosts in compose.yml).
DOCKER_GATEWAY=172.18.0.1
TZ=Europe/Stockholm
PUID=1000
PGID=1000

# ── Storage paths (host) ──
APPDATA_DIR=/srv/appdata
MEDIA_DIR=/mnt/media
STORAGE_DIR=/mnt/storage

# ── Speedtest Tracker ──
SPEEDTEST_APP_KEY=base64:generate-with-php-artisan-key-generate
# Optional comma-separated Speedtest server IDs; empty = automatic choice.
SPEEDTEST_SERVERS=

# ── Scrutiny (SMART) ──
# Stable /dev/disk/by-id paths of the data disks, never sdX names.
SMART_DISK_1=/dev/disk/by-id/ata-EXAMPLE-MODEL_EXAMPLE-SERIAL-1
SMART_DISK_2=/dev/disk/by-id/ata-EXAMPLE-MODEL_EXAMPLE-SERIAL-2

# ── Immich (photos) ──
# Pin an explicit release; all four Immich containers move together.
IMMICH_VERSION=v3.3.1
DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ── Nextcloud (files & sync) ──
NEXTCLOUD_DOMAIN=cloud.example.com
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASS=change-me
NEXTCLOUD_DB_PASS=change-me
NEXTCLOUD_REDIS_PASS=change-me

# ── Miniflux (RSS) ──
MINIFLUX_DB_PASS=change-me
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASS=change-me
# Read-only API key that the Glance start pages use for the RSS widget.
MINIFLUX_API_TOKEN=change-me

# ── Cloudflare Tunnel ──
# cloudflared reads this; it runs inside the cloudflare-egress namespace.
CLOUDFLARE_TUNNEL_TOKEN=change-me

# ── ntfy (notifications) ──
# Used by the scripts (scripts/lib.sh).
NTFY_TOPIC=homelab-alerts
# Bearer token — required when ntfy runs deny-all (anonymous publish → 403)
NTFY_TOKEN=

# ── Observability (Prometheus + Grafana) ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DOMAIN=grafana.example.com
PROMETHEUS_RETENTION=90d
