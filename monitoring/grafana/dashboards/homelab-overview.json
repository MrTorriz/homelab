        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "swap used"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
