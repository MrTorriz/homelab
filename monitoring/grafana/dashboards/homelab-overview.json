    {
      "id": 14,
      "type": "timeseries",
      "title": "Disk throughput (write below zero)",
      "description": "Disks are matched by mount point, never by sdX name",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_main"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_main"
          },
          "expr": "sum by (disk) (rate(node_disk_read_bytes_total[$__rate_interval]) * on (device) group_left (disk) (label_replace(label_replace(label_replace(label_replace(max by (device, mountpoint) (node_filesystem_size_bytes{mountpoint=~\"/|$storage_mount|$media_mount\"}), \"device\", \"$1\", \"device\", \"/dev/(nvme0n1|sd[a-z])p?[0-9]+\"), \"disk\", \"system NVMe\", \"mountpoint\", \"/\"), \"disk\", \"storage HDD\", \"mountpoint\", \"$storage_mount\"), \"disk\", \"media HDD\", \"mountpoint\", \"$media_mount\") > bool 0))",
          "legendFormat": "{{disk}} read",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_main"
          },
