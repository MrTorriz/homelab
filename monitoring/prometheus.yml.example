# Prometheus scrape config for the homelab observability stack.
# Copy to ${APPDATA_DIR}/prometheus/config/prometheus.yml and (re)start
# the prometheus container. Reload without restart with:
#   curl -X POST http://${LAN_IP}:9090/-/reload

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: 'homelab'

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node'
    static_configs:
      - targets: ['node-exporter:9100']

  # Scaphandre (host power via RAPL) was removed from the stack 2026-07-04.
  # Kept for reference: it exposes Prometheus text format 0.0.4, so the
  # fallback line is required with Prometheus 3.x.
  # - job_name: 'scaphandre'
  #   fallback_scrape_protocol: PrometheusText0.0.4
  #   static_configs:
  #     - targets: ['scaphandre:8080']

  - job_name: 'nvidia-gpu'
    static_configs:
      - targets: ['nvidia-gpu-exporter:9835']

  - job_name: 'cadvisor'
    static_configs:
      - targets: ['cadvisor:8080']
